# SQLAlchemy URL. Swapping engines later (Postgres/Oracle) means changing only
# this line plus installing the matching driver — no other code references a
# specific dialect.
DATABASE_URL=sqlite:///./mesh_scheduler.db

# Companion radio, USB serial. Confirm with:
#   python scripts/check_companion.py       (lists BLE/serial candidates)
#   python scripts/test_mesh_gateway.py -s <port> --chan-idx <idx>   (verifies gateway end-to-end)
MESH_SERIAL_PORT=COM3
MESH_SERIAL_BAUDRATE=115200

# Channel used for BOTH OTP delivery and PINx_ON/OFF actuator commands.
# Never the public channel (index 0). Don't guess the index — read it off the
# companion with `meshcli -s <port> .get_channels` and match MESH_CHANNEL_IDX
# to whatever slot already holds MESH_CHANNEL_NAME (ensure_channel() will warn,
# not reprovision, if this doesn't match — see gap register §8.1).
MESH_CHANNEL_NAME=#i2c-am2301
MESH_CHANNEL_IDX=3

# Channel broadcasts have no library-level ACK (that only exists for unicast
# send_msg/send_cmd). The actuator instead echoes its state on the same
# channel as text, decoupled from any specific send, e.g.
# "Rtp-02-switch: PIN0=ON STATE=b10000000" — confirmed against real hardware
# with scripts/test_mesh_gateway.py --listen. The gateway runs a permanent
# background listener that keeps the last-observed state per PIN; this is
# the node-name it trusts echoes from (other nodes may share the channel).
# Sending a command and the actuator's reported state are two separate,
# unlinked facts — see app/mesh/gateway.py.
MESH_ACTUATOR_NAME=Rtp-02-switch

# Hardcoded allow-list. Values are bcrypt hashes, not plaintext passwords —
# generate one with: python -c "import bcrypt; print(bcrypt.hashpw(b'pw', bcrypt.gensalt()).decode())"
AUTH_USERS=[{"user":"admin","pass_hash":"$2b$12$CHANGE_ME_REPLACE_WITH_REAL_HASH"}]

OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Random long string used to sign session cookies. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=CHANGE_ME_REPLACE_WITH_RANDOM_SECRET

# Single fixed timezone for on_time/off_time interpretation (IANA name).
# No per-browser timezone conversion in v1 — see architecture gap register §8.5.
TZ=America/Santo_Domingo

# Comma-separated list of allowed origins for the Vite dev server / deployed frontend.
CORS_ORIGINS=http://localhost:5173
